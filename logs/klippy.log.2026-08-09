[gcode_macro Z_UP]
gcode = 
	{% set Z = params.Z|default(0.01) %}
	SET_GCODE_OFFSET Z_ADJUST={Z} MOVE=1

[gcode_macro Z_DOWN]
gcode = 
	{% set Z = params.Z|default(-0.01) %}
	SET_GCODE_OFFSET Z_ADJUST={Z} MOVE=1

[gcode_macro G29]
gcode = 
	_CG28
	BED_MESH_CALIBRATE
	G0 X0 Y0 Z10 F6000
	SAVE_CONFIG

[gcode_macro M900]
gcode = 
	{% if 'K' in params %}
	{% if 'E' in params %}
	SET_PRESSURE_ADVANCE EXTRUDER={params.E} ADVANCE={params.K}
	{% else %}
	SET_PRESSURE_ADVANCE ADVANCE={params.K}
	{% endif %}
	{% endif %}

[gcode_macro M204]
rename_existing = M204.1
gcode = 
	{% set f = params.F|default(0.5)|float %}
	
	{% if 'S' in params %}
	{% set s = params.S|float %}
	SET_VELOCITY_LIMIT ACCEL={s} ACCEL_TO_DECEL={ s * f }
	{% else %}
	{% if 'P' in params %}
	{% set p = params.P|float %}
	{% if 'T' in params %}
	{% set t = params.T|float %}
	{% if p < t %}
	SET_VELOCITY_LIMIT ACCEL={p} ACCEL_TO_DECEL={ p * f }
	{% else %}
	SET_VELOCITY_LIMIT ACCEL={t} ACCEL_TO_DECEL={ t * f }
	{% endif %}
	{% else %}
	SET_VELOCITY_LIMIT ACCEL={p} ACCEL_TO_DECEL={ p * f }
	{% endif %}
	{% elif 'T' in params %}
	{% set t = params.T|float %}
	SET_VELOCITY_LIMIT ACCEL={t} ACCEL_TO_DECEL={ t * f }
	{% endif %}
	{% endif %}

[gcode_macro M201]
gcode = 
	{action_respond_info("ACK: M201 Set Print Max Acceleration")}

[gcode_macro M203]
gcode = 
	{action_respond_info("ACK: M203 Set Max Feedrate")}

[gcode_macro M205]
gcode = 
	{action_respond_info("ACK: M205 Set Advanced Settings")}

[gcode_macro _CG28]
description = Helper: Conditional homing
gcode = 
	{% if "xyz" not in printer.toolhead.homed_axes %}
	{action_respond_info("Homing active!")}
	G28
	{% else %}
	{action_respond_info("All Axes homed!")}
	{% endif %}

[gcode_macro G34]
gcode = 
	
	Z_TILT_ADJUST

[gcode_macro _CG34]
gcode = 
	{% if printer['z_tilt'].applied == false %}
	G34
	{% endif %}

[gcode_macro PRIME_LINE]
gcode = 
	{% set X = params.X|default(3) %}
	{% set Y = params.Y|default(20) %}
	{% set NOZZLE = printer.extruder.nozzle_diameter|default(0.4)|float %}
	{% set LAYER_HEIGHT = params.Z|default(NOZZLE*0.7) %}
	{% set WIDTH = params.WIDTH|default(NOZZLE*1.25)|float %}
	{% set RETRACTION_LENGTH = params.RETRACTION_LENGTH|default(0.3)|float %}
	{% set RETRACTION_SPEED = params.RETRACTION_SPEED|default(45)|int %}
	{% set Z_LIFT = params.Z_LIFT|default(5)|float %}
	{% set PRIME_SEP = (params.PRIME_SEP)|default(NOZZLE*0.75)|float %}
	{% set WIPE_LENGTH = params.WIPE_LENGTH|default(2)|float %}
	{% set FILAMENT_WIDTH = params.FILAMENT_WIDTH|default(1.75)|float %}
	{% set SPEED = params.SPEED|default(25)|int %}
	{% set STEPPER_Y_MAX = printer.configfile.config["stepper_y"]["position_max"]| float %}
	{% set LENGTH = (STEPPER_Y_MAX - 2 * Y)|round(2)|float %}
	{% set extr_multi = params.EXTRUSION_MULTIPLIER|default(1.25)|float %}
	{% set e_per_mm = extr_multi * (WIDTH * LAYER_HEIGHT) / (3.1415 * (FILAMENT_WIDTH/2)**2) %}
	
	SAVE_GCODE_STATE NAME=BEFORE_PRIME
	M117 Prime Line
	_CG28
	
	G92 E0
	G90
	{% if printer.gcode_move.gcode_position.z|float < 2.0 %}
	G0 Z2.0 F3000
	{% endif %}
	
	G0 X{X} Y{Y} F3000
	G0 Z{LAYER_HEIGHT}
	G91
	G92 E0.0
	G1 Y{LENGTH} E{ e_per_mm * LENGTH } F{(60*SPEED)}
	G1 X{PRIME_SEP} F{60*SPEED}
	G1 Y{(-1 * LENGTH)} E{ e_per_mm * LENGTH } F{(60*SPEED)}
	
	{% if WIPE_LENGTH|int != 0 %}
	G1 Y{WIPE_LENGTH} F{(60*SPEED)}
	{% endif %}
	
	{% if RETRACTION_LENGTH != 0 %}
	G92 E0.0
	G1 E{ (-1 * RETRACTION_LENGTH)} F{60 * RETRACTION_SPEED}
	{% endif %}
	
	{% if Z_LIFT > 0 %}
	G1 Z{Z_LIFT} F{(30*60)}
	{% endif %}
	G1 X10 F{(60*100)}
	
	M400
	RESTORE_GCODE_STATE NAME=BEFORE_PRIME

[gcode_macro _PARK_EXTRUDER]
gcode = 
	{% set PARK_X = printer.toolhead.axis_minimum.x + 10 %}
	{% set PARK_Y = params.PARK_Y|default(printer.toolhead.axis_minimum.y + 10) %}
	
	SAVE_GCODE_STATE NAME=parkextruder
	G90
	
	G1 X{PARK_X} Y{PARK_Y} F3000
	RESTORE_GCODE_STATE NAME=parkextruder

[gcode_macro START_PRINT]
gcode = 
	{% set T_BED = params.T_BED|default(60) %}
	{% set T_EXTRUDER = params.T_EXTRUDER|default(205) %}
	{% set no_ooze_temp = [T_EXTRUDER|int, 180]|min %}
	
	
	G21
	G92 E0
	G90
	
	
	M140 S{T_BED}
	M104 S{no_ooze_temp}
	M105
	
	
	_CG28
	
	Z_TILT_ADJUST
	G28 Z
	G0 Z10; Raise nozzle before warmup
	_PARK_EXTRUDER EXTRUDER=extruder
	
	BED_MESH_TEMP BED_TEMP={T_BED}
	
	
	
	M140 S{T_BED}
	
	
	
	
	_MOVE_TO_OOZE
	
	M117 Waiting for temperature
	M109 S{T_EXTRUDER}
	M190 S{T_BED}
	
	_CLEAN_NOZZLE
	
	PRIME_LINE
	M117 Printing...

[gcode_macro END_PRINT]
gcode = 
	M400
	M117 Done printing
	
	PRINT_CANCEL
	TURN_OFF_HEATERS
	
	M117 Ready
	
	SAVE_IF_SET

[gcode_macro IDLE_TIMEOUT]
gcode = 
	M107
	M84
	TURN_OFF_HEATERS
	
	M117 time out
	
	SAVE_IF_SET

[gcode_macro SAVE_AT_END]
variable_save = 0
gcode = 
	SET_GCODE_VARIABLE MACRO=SAVE_AT_END VARIABLE=save VALUE=1

[gcode_macro SAVE_IF_SET]
gcode = 
	{% if printer["gcode_macro SAVE_AT_END"].save == 1 %}
	{action_respond_info("Saving was requested - saving and restarting now")}
	SAVE_CONFIG
	{% else %}
	{action_respond_info("Saving was NOT requested")}
	{% endif %}

[gcode_macro M500]
gcode = 
	SAVE_CONFIG

[gcode_macro CANCEL_PRINT]
description = Cancel the actual running print
rename_existing = CANCEL_PRINT_BASE
variable_park = True
gcode = 
	{% set park_y = printer.configfile.config["stepper_y"]["position_max"]|float - 10.0 %}
	
	M400
	M107
	
	{% if printer.pause_resume.is_paused|lower == 'false' and park|lower == 'true'%}
	_TOOLHEAD_PARK_PAUSE_CANCEL
	{% endif %}
	TURN_OFF_HEATERS
	CANCEL_PRINT_BASE
	SDCARD_RESET_FILE
	
	G91
	G1 Z30
	G90
	G1 X10 Y{park_y} F{60 * 100}
	
	
	M84
	SAVE_IF_SET

[gcode_macro PRINT_CANCEL]
gcode = 
	{% set safe_z = params.safe_z|default(10) %}
	{% set park_y = printer.configfile.config["stepper_y"]["position_max"]|float - 10.0 %}
	M220 S100
	M221 S100
	
	M106 S0
	M104 S0
	M140 S0
	
	G91
	
	{% if printer.extruder.temperature > 170 %}
	G1 E-0.3 F3600
	G0 Z{safe_z} F3600
	G1 E-0.2 F3600
	{% else %}
	G0 Z{safe_z} F3600
	{% endif %}
	
	_PARK_EXTRUDER PARK_Y={park_y}
	
	G90
	
	{% set z = printer.toolhead.position.z|float %}
	{% if z < 50.0 %}
	{% set z = 50.0 %}
	{% elif (z + 5.0) > printer.configfile.config["stepper_z"]["position_max"]|float %}
	{% set z = printer.configfile.config["stepper_z"]["position_max"]|float %}
	{% else %}
	{% set z = z + 5.0 %}
	{% endif %}
	G0 Z{z}
	
	M84
	
	M117 Done

[gcode_macro _TOOLHEAD_PARK_PAUSE_CANCEL]
description = Helper: park toolhead used in PAUSE and CANCEL_PRINT
gcode = 
	
	{% set x = params.X|default(10) %}
	{% set y = params.Y|default(10) %}
	{% set z = params.Z|default(10)|float %}
	{% set e = params.E|default(0.3) %}
	
	{% set max_z = printer.toolhead.axis_maximum.z|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	{% set lift_z = z|abs %}
	{% if act_z < (max_z - lift_z) %}
	{% set z_safe = lift_z %}
	{% else %}
	{% set z_safe = max_z - act_z %}
	{% endif %}
	
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-{e} F2100
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	{% if "xyz" in printer.toolhead.homed_axes %}
	G1 Z{z_safe}
	G90
	G1 X{x} Y{y} F6000
	{% else %}
	{action_respond_info("Printer not homed")}
	{% endif %}

[gcode_macro PAUSE]
description = Pause the actual running print
rename_existing = PAUSE_BASE
gcode = 
	PAUSE_BASE
	_TOOLHEAD_PARK_PAUSE_CANCEL

[gcode_macro RESUME]
description = Resume the actual running print
rename_existing = RESUME_BASE
gcode = 
	
	{% set e = params.E|default(0.3) %}
	
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY)  %}
	{%else %}
	{% set get_params = "" %}
	{% endif %}
	
	_CLEAN_NOZZLE
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E{e} F2100
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	RESUME_BASE {get_params}
	CLEAR_PAUSE

[gcode_macro PROBE_CALIBRATE_BUTTON]
description = Run probe calibration
gcode = 
	G28
	PROBE_CALIBRATE

[gcode_macro SCREWS_TILT_CALCULATE_BUTTON]
description = Run Screws tilt calibration
gcode = 
	G28
	SCREWS_TILT_CALCULATE

[gcode_macro BED_MESH_CALIBRATE_BUTTON]
description = Run Bed Mesh calibration
gcode = 
	G28
	BED_MESH_CALIBRATE

