y_offset = 5
z_offset = 1.691

[heater_bed]
heater_pin = PD7
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PA1
min_temp = 0
max_temp = 100
control = pid
pid_kp = 70.260
pid_ki = 1.298
pid_kd = 951.148

[fan]
pin = PB7
shutdown_speed = 1.0

[heater_fan heater_fan1]
pin = PB6
kick_start_time = 1.000

[controller_fan controller_fan1]
pin = PB5
kick_start_time = 0.5

[output_pin motor_power]
pin = PC13
value = 1

[mcu btt_lis2dw]
serial = /dev/serial/by-id/usb-Klipper_rp2040_5044340410A6371C-if00

[lis2dw]
cs_pin = btt_lis2dw:gpio9
spi_software_sclk_pin = btt_lis2dw:gpio10
spi_software_mosi_pin = btt_lis2dw:gpio11
spi_software_miso_pin = btt_lis2dw:gpio8
axes_map = x,y,-z

[resonance_tester]
probe_points = 110, 110, 20
accel_chip = lis2dw

[input_shaper]
shaper_type_y = 2hump_ei
shaper_freq_y = 53.6
shaper_type_x = mzv
shaper_freq_x = 63.8

[printer]
kinematics = cartesian
max_velocity = 300
max_accel = 1000
max_z_velocity = 20
max_z_accel = 100
square_corner_velocity = 5

[gcode_arcs]
resolution = .25

[pause_resume]

[display_status]

[virtual_sdcard]
path = ~/printer_data/gcodes

[force_move]
enable_force_move = True

[safe_z_home]
home_xy_position = 110, 110
z_hop = 5
z_hop_speed = 15.0
move_to_previous = False

