	_PARK_EXTRUDER PARK_Y={park_y}
	
	G90
	
	{% set z = printer.toolhead.position.z|float %}
	{% if z < 50.0 %}
	{% set z = 50.0 %}
	{% elif (z + 5.0) > printer.configfile.config["stepper_z"]["position_max"]|float %}
	{% set z = printer.configfile.config["stepper_z"]["position_max"]|float %}
	{% else %}
	{% set z = z + 5.0 %}
	{% endif %}
	G0 Z{z}
	
	M84
	
	M117 Done

[gcode_macro _TOOLHEAD_PARK_PAUSE_CANCEL]
description = Helper: park toolhead used in PAUSE and CANCEL_PRINT
gcode = 
	
	{% set x = params.X|default(10) %}
	{% set y = params.Y|default(10) %}
	{% set z = params.Z|default(10)|float %}
	{% set e = params.E|default(0.3) %}
	
	{% set max_z = printer.toolhead.axis_maximum.z|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	{% set lift_z = z|abs %}
	{% if act_z < (max_z - lift_z) %}
	{% set z_safe = lift_z %}
	{% else %}
	{% set z_safe = max_z - act_z %}
	{% endif %}
	
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-{e} F2100
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	{% if "xyz" in printer.toolhead.homed_axes %}
	G1 Z{z_safe}
	G90
	G1 X{x} Y{y} F6000
	{% else %}
	{action_respond_info("Printer not homed")}
	{% endif %}

[gcode_macro PAUSE]
description = Pause the actual running print
rename_existing = PAUSE_BASE
gcode = 
	PAUSE_BASE
	_TOOLHEAD_PARK_PAUSE_CANCEL

[gcode_macro RESUME]
description = Resume the actual running print
rename_existing = RESUME_BASE
gcode = 
	
	{% set e = params.E|default(0.3) %}
	
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY)  %}
	{%else %}
	{% set get_params = "" %}
	{% endif %}
	
	_CLEAN_NOZZLE
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E{e} F2100
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	RESUME_BASE {get_params}
	CLEAR_PAUSE

[gcode_macro PROBE_CALIBRATE_BUTTON]
description = Run probe calibration
gcode = 
	G28
	PROBE_CALIBRATE

[gcode_macro SCREWS_TILT_CALCULATE_BUTTON]
description = Run Screws tilt calibration
gcode = 
	G28
	SCREWS_TILT_CALCULATE

[gcode_macro BED_MESH_CALIBRATE_BUTTON]
description = Run Bed Mesh calibration
gcode = 
	G28
	BED_MESH_CALIBRATE

[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32f429xx_2F0023001750305031353020-if00
restart_method = command

[tmc2209 stepper_x]
uart_pin = PE0
stealthchop_threshold = 999999
diag_pin = x_diag_pin
driver_sgthrs = 125
interpolate = False
run_current = 0.850
hold_current = 0.850

[tmc2209 stepper_y]
uart_pin = PD3
stealthchop_threshold = 999999
diag_pin = y_diag_pin
driver_sgthrs = 130
interpolate = False
run_current = 0.850
hold_current = 0.850

[tmc2209 stepper_z]
uart_pin = PD0
run_current = 0.850
hold_current = 0.850
stealthchop_threshold = 999999
diag_pin = z0_diag_pin
driver_sgthrs = 255
interpolate = False

[tmc2209 stepper_z1]
uart_pin = PD12
run_current = 0.850
hold_current = 0.850
stealthchop_threshold = 999999
diag_pin = z1_diag_pin
driver_sgthrs = 255
interpolate = False

[tmc2209 extruder]
uart_pin = PC6
run_current = 0.850
driver_sgthrs = 255
interpolate = False
hold_current = 0.850

[board_pins]
aliases = 
	
	EXP1_1=PC5, EXP1_3=PB1, EXP1_5=PE10, EXP1_7=PE12, EXP1_9=<GND>,
	EXP1_2=PB0, EXP1_4=PE9, EXP1_6=PE11, EXP1_8=PE13, EXP1_10=<5V>,
	
	EXP2_1=PA6, EXP2_3=PE7, EXP2_5=PB2, EXP2_7=PC4,   EXP2_9=<GND>,
	EXP2_2=PA5, EXP2_4=PA4, EXP2_6=PA7, EXP2_8=<RST>, EXP2_10=<NC>,
	
	x_step_pin=PE2, x_dir_pin=PE1, x_enable_pin=PE3, x_uart_pin=PE0, x_diag_pin=PC1, x_endstop_pin=null,
	y_step_pin=PD5, y_dir_pin=PD4, y_enable_pin=PD6, y_uart_pin=PD3, y_diag_pin=PC3, y_endstop_pin=null,
	z0_step_pin=PA15, z0_dir_pin=PA8, z0_enable_pin=PD1, z0_uart_pin=PD0, z0_diag_pin=PC0, z0_endstop_pin=null,
	z1_step_pin=PD11, z1_dir_pin=PD10, z1_enable_pin=PD13, z1_uart_pin=PD12, z1_diag_pin=PA0,
