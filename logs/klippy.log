position_endstop = -39
position_min = -39
position_max = 220
homing_speed = 50
homing_retract_dist = 0

[stepper_y]
step_pin = PD5
dir_pin = PD4
enable_pin = !PD6
microsteps = 16
rotation_distance = 32
endstop_pin = tmc2209_stepper_y:virtual_endstop
position_endstop = -12
position_min = -12
position_max = 220
homing_speed = 50
homing_retract_dist = 0

[stepper_z]
