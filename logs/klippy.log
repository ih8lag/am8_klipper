[controller_fan controller_fan1]
pin = PB5
kick_start_time = 0.5

[output_pin motor_power]
pin = PC13
value = 1

[mcu btt_lis2dw]
serial = /dev/serial/by-id/usb-Klipper_rp2040_5044340410A6371C-if00

[lis2dw]
