accel_chip = lis2dw

[printer]
kinematics = cartesian
max_velocity = 300
max_accel = 1000
max_z_velocity = 20
max_z_accel = 100
square_corner_velocity = 5

[gcode_arcs]
resolution = .25

[pause_resume]

[display_status]

[virtual_sdcard]
